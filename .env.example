# Copy to .env (never commit it).
# Add credentials only for channels you have registered and approved.
FLASK_SECRET_KEY=
TOKEN_ENCRYPTION_KEY=
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b
SERPAPI_API_KEY=

INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://127.0.0.1:8890/auth/instagram/callback
INSTAGRAM_SCOPES=instagram_business_basic,instagram_business_content_publish

LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://127.0.0.1:8890/auth/linkedin/callback
LINKEDIN_SCOPES=openid,profile,r_member_social,w_member_social
LINKEDIN_VERSION=202606

X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://127.0.0.1:8890/auth/x/callback
X_SCOPES=tweet.read,users.read,tweet.write,offline.access

# n8n Telegram posting workflow. Set this only for the local app that should publish.
TELEGRAM_POST_WEBHOOK_URL=

# Reuse an installed local KrishiDisha STT stack; models are never downloaded.
# Set this to the KrishiDisha installation directory on your machine.
KRISHIDISHA_ROOT=
